# helpTree environment template
#
# Copy to .env and replace every REPLACE_WITH_* value before starting anything.
# The file is intentionally secret-free: the existing SECRETS are examples, not
# defaults. Production (SPRING_PROFILES_ACTIVE=prod) refuses to start when a
# value is short, looks like a sample, or is a well-known development value.
#
# Never commit the real .env. .gitignore already excludes it.

# ---------------------------------------------------------------------------
# Required in every profile
# ---------------------------------------------------------------------------

# PostgreSQL. DB_PASS must be at least 12 characters in production.
DB_URL=jdbc:postgresql://localhost:5432/helpTree_db
DB_USER=helpTree
DB_PASS=REPLACE_WITH_A_STRONG_DB_PASSWORD

# JWT signing key. Production requires at least 64 random characters.
# Example generator: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET

# Silo / S3-compatible object storage. The same values must be given to the
# silo container and to the application.
SILO_ENDPOINT=http://localhost:9000
SILO_PUBLIC_ENDPOINT=http://localhost:9000
SILO_ACCESS_KEY=REPLACE_WITH_STORAGE_ACCESS_KEY
SILO_SECRET_KEY=REPLACE_WITH_A_STRONG_STORAGE_SECRET
SILO_BUCKET=helptree-images

# ---------------------------------------------------------------------------
# First administrator (optional, opt-in, one-time)
# ---------------------------------------------------------------------------

# Leave disabled on normal starts. For the first start of a fresh database:
#   1. set ADMIN_BOOTSTRAP_ENABLED=true;
#   2. set a valid ADMIN_EMAIL and a strong ADMIN_PASSWORD
#      (12+ characters, at least three character classes);
#   3. start once, then set ADMIN_BOOTSTRAP_ENABLED=false again.
# The bootstrap is serialized by a PostgreSQL advisory lock and never
# overwrites an existing account.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Frontend, CORS and WebSocket
# ---------------------------------------------------------------------------

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
WS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
FRONTEND_BASE_URL=http://localhost:3000

# A production deployment should set TRUST_FORWARDED_HEADERS=true only behind a
# trusted proxy that overwrites X-Forwarded-For.
TRUST_FORWARDED_HEADERS=false

# Optional STOMP relay for multi-instance deployments. When enabled, all four
# relay variables are required and are validated in production.
WS_RELAY_ENABLED=false
WS_RELAY_HOST=localhost
WS_RELAY_PORT=61613
WS_RELAY_CLIENT_LOGIN=
WS_RELAY_CLIENT_PASSCODE=
WS_RELAY_SYSTEM_LOGIN=
WS_RELAY_SYSTEM_PASSCODE=

# ---------------------------------------------------------------------------
# Feature flags (fail closed with HTTP 503 FEATURE_DISABLED)
# ---------------------------------------------------------------------------

FEATURE_REPORTS_ENABLED=true
# Shared with app.notifications.enabled; false also stops the outbox dispatcher.
NOTIFICATIONS_ENABLED=true
FEATURE_USER_BLOCKS_ENABLED=true
FEATURE_MODERATION_ENABLED=true

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Dedicated scrape account. Use the same values for the application and
# Prometheus; the password is used only for the Prometheus Basic Auth endpoint.
PROMETHEUS_SCRAPE_USERNAME=prometheus
PROMETHEUS_SCRAPE_PASSWORD=REPLACE_WITH_A_STRONG_SCRAPE_PASSWORD
# The backend is currently started on the host with the dev profile.
# Set to <backend-container-name>:8081 when the backend joins the Docker network.
PROMETHEUS_TARGET=host.docker.internal:8080

TRACING_SAMPLING_PROBABILITY=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
METRICS_REFRESH_MS=60000
METRICS_INITIAL_DELAY_MS=15000
REPORTS_SLA_HOURS=24

# Grafana has no shared default password. Required by docker-compose.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_GRAFANA_PASSWORD

# ---------------------------------------------------------------------------
# Mail (disabled until SMTP is configured)
# ---------------------------------------------------------------------------

MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@helptree.local

# ---------------------------------------------------------------------------
# Optional tuning (application defaults are used when omitted)
# ---------------------------------------------------------------------------

# Database pool
# DB_POOL_MAX=20
# DB_POOL_MIN_IDLE=5
# DB_CONNECTION_TIMEOUT_MS=30000
# DB_IDLE_TIMEOUT_MS=600000
# DB_MAX_LIFETIME_MS=1800000
# DB_LEAK_DETECTION_MS=0
# DB_QUERY_TIMEOUT_SECONDS=30
# DB_QUERY_TIMEOUT_MS=30000

# Authentication and sessions
# JWT_EXPIRATION_MS=86400000
# PASSWORD_RESET_TOKEN_MINUTES=30
# EMAIL_VERIFICATION_TOKEN_HOURS=24
# EMAIL_CHANGE_TOKEN_HOURS=24
# SESSION_TOUCH_MINUTES=1
# WS_TICKET_SECONDS=60

# Rate limiting and login protection
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_DEFAULT=600
# RATE_LIMIT_AUTH=60
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_REGISTER=5
# RATE_LIMIT_PASSWORD_RESET=5
# RATE_LIMIT_UPLOAD=20
# RATE_LIMIT_CREATE=60
# LOGIN_PROTECTION_ENABLED=true
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_FAILURE_WINDOW_MINUTES=15
# LOGIN_LOCKOUT_MINUTES=15

# Notifications and outbox
# NOTIFICATIONS_DISPATCH_CRON=0 * * * * *
# NOTIFICATIONS_BATCH_SIZE=50
# NOTIFICATIONS_MAX_BATCHES_PER_RUN=10
# NOTIFICATIONS_MAX_ATTEMPTS=5
# NOTIFICATIONS_RETRY_BASE_SECONDS=30
# NOTIFICATIONS_RETRY_MAX_SECONDS=3600
# NOTIFICATIONS_PROCESSING_TIMEOUT_MINUTES=10
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_API_URL=https://api.telegram.org

# Economy
# ECONOMY_BOOST_PRICE=5
# ECONOMY_BOOST_HOURS=24
# ECONOMY_VIP_PRICE=50
# ECONOMY_VIP_DAYS=30
# ECONOMY_NICKNAME_COLOR_PRICE=20
# ECONOMY_ACCOUNT_UNBLOCK_PRICE=100
# ECONOMY_RECONCILIATION_ENABLED=true
# ECONOMY_RECONCILIATION_CRON=0 0 4 * * *

# Upload quotas and image processing
# UPLOAD_MAX_SIZE=10485760
# UPLOAD_MAX_REQUEST_SIZE=52428800
# UPLOAD_MAX_FILES=10
# UPLOAD_MAX_WIDTH=6000
# UPLOAD_MAX_HEIGHT=6000
# UPLOAD_MAX_PIXELS=24000000
# UPLOAD_JPEG_QUALITY=0.85
# UPLOAD_QUOTA_BYTES=104857600
# UPLOAD_QUOTA_COUNT=500
# IMAGE_CLEANUP_ENABLED=true
# IMAGE_CLEANUP_ORPHAN_TTL_HOURS=24

# Graph and geocoding
# GRAPH_DEFAULT_MAX_EDGES=500
# GRAPH_MAX_EDGES=2000
# GRAPH_MAX_DEPTH=10
# GEOCODING_ENABLED=true
# GEOCODING_COUNTRY_CODE=by
# GEOCODING_WORKER_INTERVAL_MS=1100

# Scheduled jobs
# MODERATION_EXPIRY_CRON=0 5 * * * *
# HELP_SLA_ENABLED=true
# HELP_ACCEPTED_TIMEOUT_HOURS=168
# HELP_SLA_CRON=0 0 * * * *
# RATING_CALCULATION_CRON=0 0/5 * * * ?
# RATING_HISTORY_RETENTION_DAYS=365
